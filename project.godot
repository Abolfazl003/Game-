; Engine configuration file.
; Generated for NovaForge AI Game Engine (Godot 4.6+ / Jolt Physics / Zero-MCP Native AI)

config_version=5

[application]

config/name="NovaForge AI Game Engine"
config/description="Zero-MCP Local Multi-Brain AI Game Engine built on Godot 4 + Jolt Physics + C++ + Blueprint + Colibri Tiered Inference"
config/version="1.0.0"
run/main_scene="res://scenes/showcase/novaforge_sandbox.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

NovaNativeBus="*res://addons/novaforge_engine/agent/native_tool_bus.gd"
NovaBrainCouncil="*res://addons/novaforge_engine/ai_council/multi_brain_council.gd"
NovaQuality="*res://addons/novaforge_engine/quality/visual_quality_manager.gd"
NovaWorldLife="*res://addons/novaforge_engine/living_npcs/world_life_simulator.gd"
NovaTimeMachine="*res://addons/novaforge_engine/world/project_time_machine.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/novaforge_engine/plugin.cfg")

[filesystem]

import/blender/enabled=true


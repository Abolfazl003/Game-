[internationalization]

rendering/text_driver="ICU / HarfBuzz / Graphite (Built-in)"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/ssao/enabled=true
environment/sdfgi/read_sky_light=true

[configuration]

entry_symbol = "novaforge_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://native/bin/libnova_core.so"
linux.release.x86_64 = "res://native/bin/libnova_core.so"
windows.debug.x86_64 = "res://native/bin/nova_core.dll"
windows.release.x86_64 = "res://native/bin/nova_core.dll"
macos.debug = "res://native/bin/libnova_core.dylib"
macos.release = "res://native/bin/libnova_core.dylib"

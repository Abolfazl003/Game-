@tool
extends RefCounted
class_name NovaBlueprintCompiler
## GDScript & C++20 Visual Blueprint Graph Compiler (Editor & Runtime companion to native/src/nova_blueprint.cpp).


func compile_graph_dict(graph: Dictionary, target: String = "gdscript", output_path: String = "") -> Dictionary:
	var bp_name: String = graph.get("name", "GeneratedGameplayBP")
	var base_cls: String = graph.get("base_class", "CharacterBody3D")
	var nodes: Array = graph.get("blueprint_graph", graph.get("nodes", []))

	var code := ""
	if target == "cpp" or target == "cpp20_gdextension":
		code = _emit_cpp(bp_name, base_cls, nodes)
	else:
		code = _emit_gdscript(bp_name, base_cls, nodes)

	if not output_path.is_empty():
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(output_path.get_base_dir()))
		var f := FileAccess.open(output_path, FileAccess.WRITE)
		if f:
			f.store_string(code)
			f.close()

	return {
		"ok": true,
		"target": target,
		"node_count": nodes.size(),
		"code": code,
		"output_path": output_path
	}


func _emit_gdscript(bp_name: String, base_cls: String, nodes: Array) -> String:
	var lines := PackedStringArray([
		"# Generated by NovaForge Visual Blueprint Compiler",
		"extends " + base_cls,
		"class_name " + bp_name,
		"",
		"@export var max_health: float = 100.0",
		"@export var stamina: float = 100.0",
		"@export var combo_step: int = 0",
		"",
		"func _ready() -> void:"
	])
	var has_ready_body := false
	for n in nodes:
		var t: String = str(n.get("type", ""))
		if t != "Event_BeginPlay" and not t.begins_with("Event_"):
			lines.append("\tNovaNativeBus.invoke_blueprint_action(\"" + t + "\", " + JSON.stringify(n) + ")")
			has_ready_body = true
	if not has_ready_body:
		lines.append("\tpass")
	return "\n".join(lines) + "\n"


func _emit_cpp(bp_name: String, base_cls: String, nodes: Array) -> String:
	var lines := PackedStringArray([
		"// Generated by NovaForge C++20 Blueprint Compiler",
		"#include <godot_cpp/classes/" + base_cls.to_snake_case() + ".hpp>",
		"",
		"class " + bp_name + " : public godot::" + base_cls + " {",
		"    GDCLASS(" + bp_name + ", godot::" + base_cls + ")",
		"public:",
		"    void _ready() override {"
	])
	for n in nodes:
		var t: String = str(n.get("type", ""))
		if not t.begins_with("Event_"):
			lines.append("        // Dispatch Blueprint Node: " + t)
	lines.append("    }")
	lines.append("};")
	return "\n".join(lines) + "\n"
